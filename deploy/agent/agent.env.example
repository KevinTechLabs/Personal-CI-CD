# GitOps agent configuration. Install as /etc/gitops-agent/agent.env
# (deploy/agent/install.sh does this for you).

# Public repo: anonymous HTTPS read. AI-LAB needs no GitHub credentials.
REPO_URL=https://github.com/KevinTechLabs/Personal-CI-CD.git
BRANCH=environments
# Order matters: staging reconciles first so production can see it verified.
ENVIRONMENTS="staging production"

STATE_DIR=/var/lib/gitops-agent
# One file per environment containing POSTGRES_PASSWORD=<hex>. Never in Git.
SECRETS_DIR=/etc/gitops-agent/secrets

# --- rollout safety -----------------------------------------------------------
READY_TIMEOUT=120          # seconds for /ready + correct /version
SOAK_SECONDS=150           # watch period after each deploy
SOAK_INTERVAL=15
MAX_ERROR_RATIO=0.05       # roll back above 5% 5xx responses
PROMETHEUS_URL=http://127.0.0.1:9090
REQUIRE_PROMETHEUS=false   # true = treat Prometheus being down as a failure

# --- supply chain -------------------------------------------------------------
# Only images signed by this repo's pipeline workflow on main are deployed.
VERIFY_SIGNATURES=true
REQUIRE_SBOM_ATTESTATION=true
COSIGN_ISSUER=https://token.actions.githubusercontent.com
COSIGN_IDENTITY_REGEXP='^https://github\.com/(?i:kevintechlabs/personal-ci-cd)/\.github/workflows/pipeline\.yml@refs/heads/main$'

# --- notifications (optional) -------------------------------------------------
# Any endpoint accepting a plain-text POST, e.g. https://ntfy.sh/<your-topic>
NOTIFY_URL=
