# GitOps agent configuration. Install as /etc/gitops-agent/agent.env
# (deploy/agent/install.sh does this for you).

# Public repo: anonymous HTTPS read. AI-LAB needs no GitHub credentials.
REPO_URL=https://github.com/KevinTechLabs/Personal-CI-CD.git
BRANCH=environments
# Order matters: staging reconciles first so production can see it verified.
ENVIRONMENTS="staging production"

STATE_DIR=/var/lib/gitops-agent
# One file per environment containing POSTGRES_PASSWORD=<hex>. Never in Git.
SECRETS_DIR=/etc/gitops-agent/secrets

# --- rollout safety -----------------------------------------------------------
READY_TIMEOUT=120          # seconds for /ready + correct /version
SOAK_SECONDS=150           # watch period after each deploy
SOAK_INTERVAL=15
MAX_ERROR_RATIO=0.05       # roll back above 5% 5xx responses
PROMETHEUS_URL=http://127.0.0.1:9090
REQUIRE_PROMETHEUS=false   # true = treat Prometheus being down as a failure
MIN_FREE_DISK_MB=2048      # refuse to start a deploy below this (retries later)

# --- housekeeping -------------------------------------------------------------
PRUNE_IMAGES=true          # remove this app's images unused for PRUNE_AFTER
PRUNE_AFTER=168h
# Agent metrics for Prometheus (read by node-exporter's textfile collector).
METRICS_DIR=/var/lib/gitops-agent/metrics

# --- database backups -----------------------------------------------------------
# Verified pg_dump before every migration and every BACKUP_EVERY_HOURS, for the
# listed environments. Restore with deploy/agent/restore-db.sh.
BACKUP_ENVIRONMENTS=production
BACKUP_DIR=/var/lib/gitops-agent/backups
BACKUP_KEEP=14
BACKUP_EVERY_HOURS=24

# --- supply chain -------------------------------------------------------------
# Only images signed by this repo's pipeline workflow on main are deployed.
VERIFY_SIGNATURES=true
REQUIRE_SBOM_ATTESTATION=true
COSIGN_ISSUER=https://token.actions.githubusercontent.com
COSIGN_IDENTITY_REGEXP='^https://github\.com/(?i:kevintechlabs/personal-ci-cd)/\.github/workflows/pipeline\.yml@refs/heads/main$'

# --- notifications: Sentinel (optional) --------------------------------------
# Deploy events go to Sentinel (KevinTechLabs/Homelab-Soc-Dashboard): deploys
# to its activity feed; rollbacks, refused images and failures as alerts.
# `sudo deploy/observability/configure-alerts.sh --sentinel http://<ip>:8088`
# fills these in. Leave SENTINEL_URL empty to disable.
SENTINEL_URL=
SENTINEL_KEY_FILE=/etc/gitops-agent/sentinel_key
SENTINEL_SOURCE=ai-lab
