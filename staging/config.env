# Staging settings (non-secret). Promoted with every staging release.
ENVIRONMENT=staging
HOST_PORT=8081

# Fault injection for demonstrating auto-rollback. Set to e.g. 0.5, push to
# main, and watch the GitOps agent roll staging back when the error-ratio
# SLO is breached. Leave at 0 normally.
CHAOS_ERROR_RATE=0
